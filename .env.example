# =============================================================================
# Dragon Market — environment template
# Copy to .env:  cp .env.example .env
# =============================================================================

# --- PostgreSQL (shared) ---
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin1234
POSTGRES_DB=dragon_market
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Host: localhost for `go run`; docker compose overrides to `postgres` for api service
POSTGRES_HOST=localhost

# Published ports on the host machine
POSTGRES_PUBLISH_PORT=5432
APP_PUBLISH_PORT=8080

# --- HTTP server ---
# Local: :8080  |  Inside docker compose api service: overridden to :8080
HTTP_ADDR=:8080

# --- Auction worker ---
AUCTION_DURATION=24h
AUCTION_CLOSER_INTERVAL=1m

# --- Oracle sync (reference prices, display only) ---
ORACLE_SYNC_INTERVAL=30s
